generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String        @id @default(uuid())
  name                  String
  email                 String        @unique
  public_key            String?
  created_at            DateTime      @default(now())
  password              String
  sms_secret_key        String?
  phone                 String?       @unique
  transactions_received Transaction[] @relation("receivedTransactions")
  transactions_sent     Transaction[] @relation("sentTransactions")
  wallet                Wallet?
  bankAccount           BankAccount?
  withdrawals           Withdrawal[]
  messages_sent         Message[]     @relation("sentMessages")
  messages_received     Message[]     @relation("receivedMessages")
}

model Wallet {
  id              String   @id @default(uuid())
  user_id         String   @unique
  balance         Decimal  @default(0) @db.Decimal(12, 2)
  locked_balance  Decimal  @default(0) @db.Decimal(12, 2)
  updated_at      DateTime @updatedAt
  offline_balance Decimal  @default(0) @db.Decimal(12, 2)
  user            User     @relation(fields: [user_id], references: [id])
}

model Transaction {
  id          String   @id @default(uuid())
  sender_id   String
  receiver_id String
  amount      Decimal  @db.Decimal(12, 2)
  status      String
  nonce       BigInt   @unique
  signature   String
  is_offline  Boolean  @default(true)
  created_at  DateTime @default(now())
  note        String?
  receiver    User     @relation("receivedTransactions", fields: [receiver_id], references: [id])
  sender      User     @relation("sentTransactions", fields: [sender_id], references: [id])
}

model SyncLog {
  id             String   @id @default(uuid())
  transaction_id String
  sync_status    String
  attempts       Int      @default(0)
  updated_at     DateTime @updatedAt
}

model BankAccount {
  id                String   @id @default(uuid())
  accountNumber     String
  ifscCode          String
  accountHolderName String
  createdAt         DateTime @default(now())
  user_id           String   @unique
  user              User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("bank_accounts")
}

model Withdrawal {
  id          String    @id @default(uuid())
  amount      Decimal   @db.Decimal(12, 2)
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  processedAt DateTime?
  user_id     String
  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("withdrawals")
}

model Message {
  id          String   @id @default(uuid())
  sender_id   String
  receiver_id String
  content     String
  created_at  DateTime @default(now())
  sender      User     @relation("sentMessages", fields: [sender_id], references: [id])
  receiver    User     @relation("receivedMessages", fields: [receiver_id], references: [id])

  @@index([sender_id, receiver_id])
  @@index([receiver_id, sender_id])
  @@map("messages")
}

model Otp {
  id         String   @id @default(uuid())
  phone      String
  code       String
  attempts   Int      @default(0)
  expires_at DateTime
  created_at DateTime @default(now())

  @@index([phone])
  @@map("otps")
}
